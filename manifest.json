{
  "manifest_version": 3,
  "name": "Tracker Blocker",
  "version": "2.1.1",
  "description": "Blocheaza pixeli de tracking (liste proprii + EasyPrivacy), curata URL-uri de fbclid/gclid/utm_*, detecteaza CNAME cloaking, reduce fingerprinting-ul si protejeaza impotriva scurgerilor WebRTC.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "webRequest",
    "privacy",
    "browsingData",
    "alarms",
    "scripting",
    "webNavigation",
    "activeTab",
    "cookies"
  ],
  "options_page": "options.html",
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tracker Blocker"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "pixel_rules",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "easyprivacy_rules",
        "enabled": true,
        "path": "rules-easyprivacy.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
